rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the existing multiplayer behavior. The deployed project already
    // permits unauthenticated room clients; this feature does not broaden that
    // rule to any other collection.
    match /rooms/{roomCode} {
      allow read, write: if true;
    }

    function isEraId(eraId) {
      return eraId == 'era-1' || eraId == 'era-2';
    }

    function validProgram() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion',
          'activeEraId',
          'sourceFingerprints',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 2
        && data.activeEraId == 'era-2'
        && (!('sourceFingerprints' in data) || data.sourceFingerprints is list)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function validEra(eraId) {
      let data = request.resource.data;
      return isEraId(eraId)
        && data.keys().hasOnly([
          'schemaVersion',
          'id',
          'name',
          'description',
          'startDate',
          'durationDays',
          'status',
          'retiredOn',
          'updatedAt'
        ])
        && data.schemaVersion == 2
        && data.id == eraId
        && data.name is string
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 200
        && data.startDate is string
        && data.durationDays == 90
        && (data.status == 'active' || data.status == 'archived')
        && (!('retiredOn' in data) || data.retiredOn is string)
        && data.updatedAt is timestamp;
    }

    function validRecord(eraId) {
      let data = request.resource.data;
      let payload = data.payload;
      return isEraId(eraId)
        && data.keys().hasOnly([
          'schemaVersion',
          'eraId',
          'key',
          'payload',
          'clientUpdatedAt',
          'sourceClientId',
          'serverUpdatedAt'
        ])
        && data.schemaVersion == 2
        && data.eraId == eraId
        && data.key is string
        && data.key.size() <= 200
        && data.clientUpdatedAt is int
        && data.sourceClientId is string
        && data.sourceClientId.size() <= 100
        && data.serverUpdatedAt is timestamp
        && payload is map
        && payload.keys().hasAll(['key', 'completed', 'updatedAt'])
        && payload.key is string
        && payload.completed is map
        && payload.updatedAt is int
        && payload.updatedAt == data.clientUpdatedAt
        && (!('note' in payload) || (payload.note is string && payload.note.size() <= 20000));
    }

    function validBackup() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion',
          'sourceKey',
          'fingerprint',
          'recordCount',
          'byteLength',
          'stored',
          'rawJson',
          'createdAt'
        ])
        && data.schemaVersion == 1
        && data.sourceKey == 'transform:v1:records'
        && data.fingerprint is string
        && data.recordCount is int
        && data.recordCount >= 0
        && data.byteLength is int
        && data.byteLength >= 0
        && data.stored is bool
        && ((!data.stored && !('rawJson' in data))
          || (data.stored && data.rawJson is string && data.rawJson.size() <= 700000))
        && data.createdAt is timestamp;
    }

    // Option A: the browser talks directly to Firestore. These records are
    // deliberately unauthenticated, matching the accepted low-sensitivity
    // threat model; the existing passphrase remains the user-facing gate.
    match /transformation/{programId} {
      allow read: if programId == 'personal';
      allow create, update: if programId == 'personal' && validProgram();
      allow delete: if false;

      match /eras/{eraId} {
        allow read: if programId == 'personal' && isEraId(eraId);
        allow create, update: if programId == 'personal' && validEra(eraId);
        allow delete: if false;

        match /records/{recordId} {
          allow read: if programId == 'personal' && isEraId(eraId);
          allow create, update: if programId == 'personal' && validRecord(eraId);
          allow delete: if false;
        }
      }

      match /backups/{backupId} {
        allow read: if programId == 'personal';
        allow create: if programId == 'personal' && validBackup();
        allow update, delete: if false;
      }
    }
  }
}
